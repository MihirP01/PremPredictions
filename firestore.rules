rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMember(roomCode) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(uid()));
    }

    function isLeader(roomCode) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomCode)).data.leaderUid == uid();
    }

    // Users: only self (used by login + room-gate)
    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == uid();
      allow delete: if false;
    }

    // Rooms
    match /rooms/{roomCode} {
      // Needed so signed-in users can check room existence in room-gate
      allow read: if signedIn();

      // Room creation from room-gate: creator must be leaderUid
      allow create: if signedIn() && request.resource.data.leaderUid == uid();

      // Lock direct room doc mutations from clients
      allow update, delete: if false;

      // Room players
      match /players/{playerUid} {
        // Only room members can see member list
        allow read: if isMember(roomCode);

        // Join/update own membership doc (room-gate flow)
        allow create, update: if signedIn() && playerUid == uid();

        // Allow self-leave OR leader kick (not self)
        allow delete: if (signedIn() && playerUid == uid())
                      || (isLeader(roomCode) && playerUid != uid());
      }

      // Game root docs
      match /games/{gameId} {
        allow read: if isMember(roomCode);
        // Created/updated by Admin SDK API routes only
        allow create, update, delete: if false;

        // Minigame lobby presence (client heartbeat)
        match /lobby/{playerUid} {
          allow read: if isMember(roomCode);
          allow create, update, delete: if signedIn() && playerUid == uid();
        }

        // Picks + golden are server-authoritative via API (Admin SDK)
        match /picks/{docId} {
          allow read: if isMember(roomCode);
          allow write: if false;
        }

        match /golden/{playerUid} {
          allow read: if isMember(roomCode);
          allow write: if false;
        }
      }

      // Saved computed scores used by leaderboard page
      match /scores/{gwId} {
        allow read: if isMember(roomCode);
        allow write: if false;

        match /users/{playerUid} {
          allow read: if isMember(roomCode);
          allow write: if false;
        }
      }

      // Keep predictions locked unless you open this feature
      match /predictions/{gw}/items/{docId} {
        allow read: if isMember(roomCode);
        allow write: if false;
      }
    }
  }
}
