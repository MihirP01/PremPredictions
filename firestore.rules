rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSelf(playerUid) { return signedIn() && playerUid == uid(); }
    function isMember(roomCode) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(uid()));
    }
    function isLeader(roomCode) {
      return signedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomCode)).data.leaderUid == uid();
    }

    // Users: only self
    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == uid();
      allow delete: if false;
    }

    match /rooms/{roomCode} {
      // Signed-in users can discover/open rooms; membership controls all sub-data.
      allow read: if signedIn();
      // Room creation + settings/secure writes are server-only (Admin SDK routes).
      allow create, update, delete: if false;

      // Explicitly lock private security material.
      match /private/{docId} {
        allow read, write: if false;
      }

      match /players/{playerUid} {
        // Members can read full list; each user can also read their own membership doc.
        allow read: if isMember(roomCode) || isSelf(playerUid);
        // Joining is server-only to enforce password checks.
        allow create: if false;
        // Allow own profile updates (nickname/displayName) only.
        allow update: if isSelf(playerUid);
        // Self leave OR leader kick (not self).
        allow delete: if isSelf(playerUid) || (isLeader(roomCode) && playerUid != uid());
      }

      // Legacy game root (kept read-only/member-aware for compatibility).
      match /games/{gameId} {
        allow read: if isMember(roomCode);
        allow create, update, delete: if false;

        match /lobby/{playerUid} {
          allow read: if isMember(roomCode);
          allow create, update, delete: if isSelf(playerUid);
        }
        match /picks/{docId} {
          allow read: if isMember(roomCode);
          allow write: if false;
        }
        match /golden/{playerUid} {
          allow read: if isMember(roomCode);
          allow write: if false;
        }
      }

      // Season-scoped data.
      match /seasons/{seasonKey} {
        allow read: if isMember(roomCode);
        allow write: if false;

        match /games/{gameId} {
          allow read: if isMember(roomCode);
          allow create, update, delete: if false;

          match /lobby/{playerUid} {
            allow read: if isMember(roomCode);
            allow create, update, delete: if isSelf(playerUid);
          }
          match /picks/{docId} {
            allow read: if isMember(roomCode);
            allow write: if false;
          }
          match /golden/{playerUid} {
            allow read: if isMember(roomCode);
            allow write: if false;
          }
        }

        match /scores/{gwId} {
          allow read: if isMember(roomCode);
          allow write: if false;
          match /users/{playerUid} {
            allow read: if isMember(roomCode);
            allow write: if false;
          }
        }
      }

      // Legacy top-level score docs.
      match /scores/{gwId} {
        allow read: if isMember(roomCode);
        allow write: if false;
        match /users/{playerUid} {
          allow read: if isMember(roomCode);
          allow write: if false;
        }
      }

      match /predictions/{gw}/items/{docId} {
        allow read: if isMember(roomCode);
        allow write: if false;
      }
    }
  }
}
