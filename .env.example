# Firebase client configuration (embedded during npm run build)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (runtime; keep secret)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Application services (runtime; keep secret)
FOOTBALLDATA_KEY=
CRON_SECRET=

# PostgreSQL migration shadow database
POSTGRES_PASSWORD=change-to-a-long-url-safe-password
DATABASE_URL=postgresql://prem_predictions:change-me@localhost:5432/prem_predictions
POSTGRES_POOL_MAX=10
